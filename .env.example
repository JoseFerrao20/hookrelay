# Copy to .env to override defaults. Values below are the defaults.
SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hookrelay
DB_USER=hookrelay
DB_PASSWORD=hookrelay
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=hookrelay
RABBITMQ_PASSWORD=hookrelay
RABBITMQ_VHOST=/
SINK_PORT=8090
# Retry policy (E3). Use e.g. 1s / 5s / 0 for fast local retries.
HOOKRELAY_RETRY_MAX_ATTEMPTS=10
HOOKRELAY_RETRY_INITIAL_DELAY=30s
HOOKRELAY_RETRY_MAX_DELAY=6h
HOOKRELAY_RETRY_JITTER=0.2

# --- Security (E4) ---
# DEV ONLY — never use in production. These are the compose defaults.
# Generate real values with:
#   API key (>= 32 chars):  openssl rand -hex 32
#   Encryption key (Base64 of 32 bytes):  openssl rand -base64 32
HOOKRELAY_SECURITY_API_KEYS=dev-only-api-key-change-me-0123456789
HOOKRELAY_SECURITY_SECRET_ENCRYPTION_KEY=UdKWZ1MTu1xNwgT2kj0IUXRMinovUAlOyKXwtMmuoGM=
# Hosts that skip the SSRF check (comma-separated). Local compose uses the sink.
HOOKRELAY_SECURITY_SSRF_ALLOWED_HOSTS=webhook-sink
# Used by scripts/smoke-test.sh (defaults to the dev key above).
HOOKRELAY_API_KEY=dev-only-api-key-change-me-0123456789
